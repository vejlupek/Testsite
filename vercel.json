{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:ico|svg|png|jpg|webp|woff2))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/vymena-vodovodn%C3%AD-baterie",
      "destination": "/blog/vymena-vodovodni-baterie/",
      "permanent": true
    },
    {
      "source": "/blog/vymena-vodovodn%C3%AD-baterie/",
      "destination": "/blog/vymena-vodovodni-baterie/",
      "permanent": true
    },
    {
      "source": "/blog/vymena-vodovodní-baterie",
      "destination": "/blog/vymena-vodovodni-baterie/",
      "permanent": true
    },
    {
      "source": "/blog/vymena-vodovodní-baterie/",
      "destination": "/blog/vymena-vodovodni-baterie/",
      "permanent": true
    }
  ]
}
