---
interface Props {
  icon: string;
  title: string;
  description: string;
  href?: string;
}
const { icon, title, description, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['service-card', { 'service-card--link': href }]} href={href}>
  <span class="service-icon">{icon}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  {href && <span class="service-more" aria-hidden="true">→</span>}
</Tag>

<style>
  .service-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--card-radius);
    padding: var(--card-padding);
    transition: all var(--transition-base);
  }
  .service-card:hover {
    border-left-color: var(--primary);
    border-color: var(--primary);
    box-shadow: var(--shadow-brand);
    transform: translateY(-3px);
  }
  .service-icon { font-size: 2.2rem; margin-bottom: 0.9rem; display: block; }
  .service-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }
  .service-card p { font-size: 0.88rem; color: var(--text-light); line-height: 1.55; }
  .service-card--link { display: block; text-decoration: none; color: inherit; position: relative; }
  .service-more { position: absolute; top: 1rem; right: 1.2rem; color: var(--primary); font-weight: 800; font-size: 1.2rem; }
</style>
