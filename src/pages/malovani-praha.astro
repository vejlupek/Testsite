---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import Contact from '../components/Contact.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { pickReviews } from '../data/reviews';
import { googleReviews, formatRating, reviewsLabel } from '../data/google-reviews';
import { SITE_URL, businessEntity, faqSchema } from '../data/business';
import heroImg from '../assets/images/josef-vejlupek-photo.png';
import '../styles/landing.css';

const pageUrl = `${SITE_URL}/malovani-praha/`;

const items = [
  { title: "Vymalování pokoje a bytu", desc: "Bílá i barevná malba stěn a stropů – od jednoho pokoje po celý byt. Dvě vrstvy, rovnoměrně, bez pruhů." },
  { title: "Malování před nastěhováním a předáním bytu", desc: "Rychlé vymalování mezi nájemníky nebo před stěhováním, aby byl byt připravený včas." },
  { title: "Opravy omítek a prasklin", desc: "Vyspravení děr po hmoždinkách, prasklin a otlučených rohů. Přebroušení a penetrace, aby nová malba držela." },
  { title: "Skvrny a malůvky na zdi", desc: "Malůvky po dětech, mastné fleky nebo skvrny po zatečení – správný podklad nebo izolační barva, aby skvrna neprosvítala." },
  { title: "Barevné stěny a ostré přechody", desc: "Akcentová stěna, dvě barvy v místnosti, čisté linky u stropu a kolem zárubní." },
  { title: "Příprava a úklid", desc: "Zakrytí podlah a nábytku, olepení lišt a vypínačů, po malování úklid. Vy se vracíte do hotového pokoje." },
];

const factors = [
  "Plocha stěn a stropů a jejich výška",
  "Stav podkladu – kolik je potřeba opravit a zapenetrovat",
  "Bílá, nebo barevná malba (barevná často potřebuje vrstvu navíc)",
  "Kolik nábytku je v místnosti a jestli je potřeba ho přesouvat",
];

const faqs = [
  { q: "Kolik stojí vymalování pokoje nebo bytu?", a: "U celého pokoje nebo bytu vám řeknu pevnou cenu předem – stačí poslat fotky místností a přibližné rozměry, případně se přijedu podívat. Drobné malování (jedna stěna, opravy po hmoždinkách) účtuji hodinově: minimální zakázka 1 450 Kč včetně dopravy a první hodiny, každá další hodina 490 Kč." },
  { q: "Musím před malováním vystěhovat nábytek?", a: "Ne. Nábytek posunu doprostřed místnosti a zakryju fólií, podlahy zakryju a olepím. Stačí, když předem uklidíte drobné věci z polic a ze stěn sundáte obrazy." },
  { q: "Kdo kupuje barvu?", a: "Jak vám to vyhovuje. Barvu můžu zajistit – poradím s výběrem a účtuji ji dle skutečnosti. Pokud máte konkrétní odstín, stačí mi dát vědět, nebo barvu koupit sami." },
  { q: "Uklidíte po malování?", a: "Ano, úklid je součástí práce. Odstraním fólie a pásky, posbírám nečistoty a vrátím místnost do stavu, kdy ji můžete hned používat." },
  { q: "Jak dlouho malování trvá a kdy můžu místnost používat?", a: "Běžný pokoj obvykle zvládnu během jednoho dne, celý byt 3+1 zpravidla za 1–2 dny – přesný odhad dostanete s cenou. Dnešní interiérové barvy schnou rychle a nezapáchají, takže místnost můžete většinou používat ještě týž den večer." },
  { q: "Zakryjete skvrny po zatečení nebo malůvky po dětech?", a: "Ano. Skvrny po vodě, kouři nebo fixách by obyčejnou barvou prosvítaly – nejdřív je přetřu izolační barvou a pak teprve maluji. Hotová stěna je jednolitá." },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Malování interiérů",
  "name": "Malování Praha – vymalování bytu a pokoje",
  "description": "Malování interiérů v Praze: vymalování pokoje a bytu, opravy omítek a prasklin, zakrytí skvrn, barevné stěny. Příprava, zakrytí a úklid po malování.",
  "url": pageUrl,
  "areaServed": { "@type": "City", "name": "Praha" },
  "provider": businessEntity('cs'),
  "offers": {
    "@type": "Offer",
    "price": "1450",
    "priceCurrency": "CZK",
    "description": "Drobné malování hodinově (1 450 Kč vč. dopravy a 1. hodiny, pak 490 Kč/h). Pokoj nebo byt za pevnou cenu dohodnutou předem."
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Domů", "item": `${SITE_URL}/` },
    { "@type": "ListItem", "position": 2, "name": "Malování Praha", "item": pageUrl }
  ]
};

const pageReviews = pickReviews(['patrik', 'zb', 'karel']);
---

<BaseLayout
  ogImage="/og/malovani.jpg"
  title="Malování Praha – vymalování bytu a pokoje | Malíř Pepe Vejlupek"
  description={`Vymalování pokoje i celého bytu v Praze ⭐ ${formatRating('cs')} na Google. Opravy omítek, zakrytí skvrn, zakrytí nábytku a úklid po malování. Pevná cena předem.`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema(faqs))} />

  <main>

    <section class="lp-hero">
      <div class="lp-hero-inner lp-hero-grid">
        <div>
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Domů</a>
            <span aria-hidden="true">›</span>
            <span aria-current="page">Malování Praha</span>
          </nav>
          <div class="lp-badge">🎨 Hodinový manžel – malířské práce</div>
          <h1>Malování Praha – vymalování bytu a pokoje</h1>
          <p class="lp-perex">
            Potřebujete vymalovat pokoj, celý byt nebo jen zakrýt malůvky po dětech? Zakryju nábytek a podlahy,
            opravím díry a praskliny, vymaluji a po sobě uklidím. Cenu za celý pokoj nebo byt znáte předem.
          </p>
          <div class="lp-buttons">
            <a href="tel:+420774399400" class="btn btn-primary lp-btn-call">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
              +420 774 399 400
            </a>
            <a href="#kontakt" class="btn btn-outline">✉️ Poslat fotky místností</a>
          </div>
          <p class="lp-note">Zvedám telefon osobně · Po–Pá 8–18 · cenu pošlu podle fotek</p>
          <div class="lp-trust">
            <a href={googleReviews.url} target="_blank" rel="noopener" style="color:inherit;">⭐ {formatRating('cs')} · {reviewsLabel('cs')}</a>
            <span class="sep">·</span>
            <span>Úklid po malování</span>
            <span class="sep">·</span>
            <span>Celá Praha</span>
          </div>
        </div>
        <div class="lp-hero-img">
          <Image src={heroImg} alt="Pepe Vejlupek – hodinový manžel a malíř v Praze" widths={[400, 700, 1000]} sizes="(max-width: 860px) 100vw, 500px" loading="eager" class="lp-hero-portrait" style="object-position:center 25%;" />
        </div>
      </div>
    </section>

    <TrustBar />

    <section class="lp-section lp-section--bg">
      <div class="section-inner">
        <div class="section-header">
          <h2>Co při malování udělám</h2>
          <p>Malování interiérů od přípravy po úklid – pokoje, kuchyně, chodby i celé byty.</p>
        </div>
        <div class="lp-cards">
          {items.map(i => (
            <div class="lp-card">
              <h3>{i.title}</h3>
              <p>{i.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-section lp-section--white">
      <div class="section-inner">
        <div class="lp-why-grid">
          <div>
            <h2>Kolik stojí vymalování pokoje nebo bytu</h2>
            <p>U celého pokoje nebo bytu dostanete <strong>pevnou cenu předem</strong> – bez překvapení na konci. Stačí poslat fotky místností a přibližné rozměry, nebo se přijedu podívat. Cena závisí hlavně na:</p>
            <ul class="why-list">
              {factors.map(f => <li>{f}</li>)}
            </ul>
            <p style="margin-top:1.25rem;">Drobné malování – jedna stěna, opravy po hmoždinkách, přetření skvrny – účtuji hodinově podle ceníku vpravo.</p>
          </div>
          <div class="lp-pricing-box">
            <h3>Ceník</h3>
            <div class="price-row">
              <span>Pokoj nebo celý byt</span>
              <strong>pevná cena předem</strong>
            </div>
            <div class="price-row">
              <span>Drobné malování (1. hodina + doprava)</span>
              <strong>1 450 Kč</strong>
            </div>
            <div class="price-row">
              <span>Každá další hodina</span>
              <strong>490 Kč</strong>
            </div>
            <div class="price-row">
              <span>Barva a materiál</span>
              <strong>dle skutečnosti</strong>
            </div>
            <p class="price-note">Nejsem plátce DPH.</p>
            <a href="#kontakt" class="btn btn-primary">Poslat fotky a získat cenu</a>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-section lp-section--bg">
      <div class="section-inner">
        <div class="section-header">
          <h2>Jak malování probíhá</h2>
        </div>
        <ol class="lp-steps">
          <li><h3>Fotky nebo prohlídka</h3><p>Pošlete fotky místností a rozměry, nebo se přijedu podívat. Domluvíme barvu a termín.</p></li>
          <li><h3>Pevná cena</h3><p>Řeknu vám cenu i dobu malování předem – žádné doplatky navíc.</p></li>
          <li><h3>Příprava</h3><p>Zakryju podlahy a nábytek, olepím lišty a vypínače, opravím díry a praskliny, zapenetruji.</p></li>
          <li><h3>Malování a úklid</h3><p>Vymaluji ve dvou vrstvách, odstraním fólie a pásky a po sobě uklidím.</p></li>
        </ol>
      </div>
    </section>

    <section class="lp-section lp-section--white">
      <div class="section-inner">
        <div class="section-header">
          <h2>Co říkají zákazníci o malování</h2>
        </div>
        <div class="lp-reviews" style="max-width:1100px;">
          {pageReviews.map(r => (
            <ReviewCard text={r.text.cs} author={r.author} location={r.service.cs} ariaLabel="Hodnocení 5 z 5 hvězdiček" />
          ))}
        </div>
        <p style="text-align:center;margin-top:1.5rem;"><a href={googleReviews.url} target="_blank" rel="noopener">Přečíst všechny recenze na Google →</a></p>
      </div>
    </section>

    <section class="lp-section lp-section--bg">
      <div class="section-inner">
        <div class="lp-faq" style="max-width:760px;margin:0 auto;">
          <h2>Časté otázky k malování</h2>
          {faqs.map(f => (
            <details>
              <summary>{f.q}</summary>
              <p set:html={f.a} />
            </details>
          ))}
          <p style="margin-top:1.25rem;">Chcete malovat sami? Přečtěte si moje návody <a href="/blog/jak-spravne-malovat-steny/">jak správně malovat stěny</a> a <a href="/blog/priprava-pred-malovani/">příprava stěn před malováním</a>.</p>
        </div>
      </div>
    </section>

    <Contact />

  </main>
</BaseLayout>
