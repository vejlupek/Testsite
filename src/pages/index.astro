---
import { businessEntity } from '../data/business';
import { formatRating, reviewsLabel } from '../data/google-reviews';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Reviews from '../components/Reviews.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';

const jsonLd = {
  "@context": "https://schema.org",
  ...businessEntity('cs'),
  "description": "Hodinový manžel pro celou Prahu. Montáž nábytku, opravy, malování, instalatérské práce.",
  "areaServed": [
    { "@type": "City", "name": "Praha" },
    { "@type": "AdministrativeArea", "name": "Praha 1" },
    { "@type": "AdministrativeArea", "name": "Praha 2" },
    { "@type": "AdministrativeArea", "name": "Praha 3" },
    { "@type": "AdministrativeArea", "name": "Praha 4" },
    { "@type": "AdministrativeArea", "name": "Praha 5" },
    { "@type": "AdministrativeArea", "name": "Praha 6" },
    { "@type": "AdministrativeArea", "name": "Praha 7" },
    { "@type": "AdministrativeArea", "name": "Praha 8" },
    { "@type": "AdministrativeArea", "name": "Praha 9" },
    { "@type": "AdministrativeArea", "name": "Praha 10" },
    { "@type": "AdministrativeArea", "name": "Praha 11" },
    { "@type": "AdministrativeArea", "name": "Praha 12" },
    { "@type": "Neighborhood", "name": "Vinohrady" },
    { "@type": "Neighborhood", "name": "Nusle" },
    { "@type": "Neighborhood", "name": "Žižkov" },
    { "@type": "Neighborhood", "name": "Smíchov" },
    { "@type": "Neighborhood", "name": "Košíře" },
    { "@type": "Neighborhood", "name": "Barrandov" },
    { "@type": "Neighborhood", "name": "Dejvice" },
    { "@type": "Neighborhood", "name": "Bubeneč" },
    { "@type": "Neighborhood", "name": "Vršovice" },
    { "@type": "Neighborhood", "name": "Strašnice" },
    { "@type": "Neighborhood", "name": "Modřany" },
    { "@type": "Neighborhood", "name": "Komořany" }
  ]
};
---

<BaseLayout
  title="Hodinový manžel Praha – opravy, montáž nábytku | Pepe Vejlupek"
  description={`Hodinový manžel v Praze ⭐ ${formatRating('cs')} – ${reviewsLabel('cs')}. Montáž nábytku, opravy, malování, instalatérské práce. Od 1 450 Kč vč. dopravy, odezva do 2 hodin.`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <main>
    <Hero />
    <TrustBar />
    <Services />
    <About />
    <Reviews />
    <Pricing />
    <Faq />
    <Contact />
  </main>
</BaseLayout>
